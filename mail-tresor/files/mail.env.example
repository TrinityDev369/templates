# ─── Trinity Mail — tenant env block (Tresor-governed) ───────────────────────
# These keys are declared in `mail.tresor.ts` (risk / rotation / validation) and
# merged into your project's `tresor/tresor.config.ts`. Real values live ONLY in
# `tresor/vault.env` (never committed); `tresor sync` generates the runtime `.env`.
# Never commit real values; never hardcode them.

# Driver: relay | console | sink.  Default 'console' (logs, no network) so local dev
# never burns the shared sending reputation. Set 'relay' only with real credentials.
MAIL_DRIVER=console

# Tenant identity at the relay (the X-Trinity-Project tag).
MAIL_PROJECT=ozean-licht

# Default sender + reply-to. "Name <email>" or "email".
MAIL_FROM=Ozean Licht <noreply@ozean-licht.com>
MAIL_FROM_NAME=Ozean Licht
MAIL_REPLY_TO=support@ozean-licht.com

# Bounce / Return-Path subdomain — DSNs route here for central processing.
MAIL_BOUNCE_DOMAIN=bounce.ozean-licht.com

# ─── Relay SMTP (only needed when MAIL_DRIVER=relay) ─────────────────────────
RELAY_SMTP_HOST=relay.trinity.agency
RELAY_SMTP_PORT=465            # 465 implicit TLS (default - what the relay serves); 587 STARTTLS not enabled
RELAY_SMTP_USER=
RELAY_SMTP_PASS=
RELAY_SMTP_SECURE=true         # implicit TLS for 465 (default); set false only if forced onto 587

# ─── Outbox + guardrails ─────────────────────────────────────────────────────
MAIL_OUTBOX_MAX_ATTEMPTS=6
MAIL_OUTBOX_BACKOFF_MS=30000   # base; exponential w/ jitter, capped at 1h
MAIL_RATE_MAX=60               # max sends per window, per project+stream
MAIL_RATE_WINDOW_MS=60000

# Outbox store (postgres.js). Omit to use the in-memory store (dev/tests only).
DATABASE_URL=postgres://user:pass@localhost:5432/app

# Shared with mail-webhook for verifying inbound relay events. Issued by trinity-mail init.
RELAY_WEBHOOK_SECRET=

# Symmetric key for mail-webhook to encrypt retained bodies as crypto-shreddable
# ciphertext ("view in browser"). DSGVO erasure = destroy this key. Issued by trinity-mail init.
MAIL_BODY_KEY=
